rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Produits : lecture/écriture uniquement par le propriétaire
    match /products/{productId} {
      allow read, write: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null;
    }

    // Scans : écriture publique (QR scan anonyme), lecture propriétaire
    match /scans/{scanId} {
      allow create: if true;
      allow read: if request.auth != null;
    }

    // Breakouts : propriétaire uniquement
    match /breakouts/{breakoutId} {
      allow read, write: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    // Users : chacun voit seulement son profil
    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // Subscriptions : lecture seule par le propriétaire
    match /subscriptions/{userId} {
      allow read: if request.auth != null
        && request.auth.uid == userId;
    }

    // Variations : propriétaire uniquement
    match /variations/{variationId} {
      allow read, write: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null;
    }

    // Referrals : lecture publique du code, écriture propriétaire
    match /referrals/{referralCode} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == resource.data.referrerId;
    }

    // Partners : propriétaire uniquement
    match /partners/{partnerId} {
      allow read, write: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    // Marketplace : lecture publique, écriture vendeur
    match /marketplace/{listingId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.sellerId;
    }

    // Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
